DSSeptiembre@page "/kardex/{Id:long}"
@inject IClienteNaturalService ClienteNaturalService

<PageTitle>Kardex de Cliente Natural</PageTitle>

<div class="mb-6 flex flex-wrap items-end justify-between gap-3">
    <div>
        <h1 class="text-2xl font-bold">Kardex de Cliente Natural</h1>
        <p class="text-sm text-slate-500">R004 · Imprimir kardex de cliente natural</p>
    </div>
    <div class="print:hidden flex gap-2">
        <a href="clientes-naturales" class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium hover:bg-slate-100">
            Volver
        </a>
        @if (cliente is not null)
        {
            <PrintButton Texto="Imprimir kardex" />
        }
    </div>
</div>

@if (cargando)
{
    <p class="text-sm text-slate-500">Cargando...</p>
}
else if (cliente is null)
{
    <div class="rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-700">
        @(mensaje ?? "No se encontró el cliente solicitado.")
    </div>
}
else
{
    <article class="rounded-lg bg-white p-8 shadow print:shadow-none">
        <header class="mb-6 border-b border-slate-200 pb-4">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h2 class="text-xl font-bold">DSSeptiembre</h2>
                    <p class="text-sm text-slate-500">Kardex de cliente natural</p>
                </div>
                <div class="text-right text-sm text-slate-500">
                    <p>Código: <span class="font-medium text-slate-700">@cliente.Id</span></p>
                    <p>Emitido: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>
        </header>

        <section class="mb-6">
            <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-400">Datos personales</h3>
            <dl class="grid gap-x-8 gap-y-3 sm:grid-cols-2">
                <div>
                    <dt class="text-xs text-slate-400">Nombre completo</dt>
                    <dd class="font-medium">@cliente.NombreCompleto</dd>
                </div>
                <div>
                    <dt class="text-xs text-slate-400">Documento de identidad</dt>
                    <dd class="font-medium">@(cliente.DocumentoIdentidad ?? "-")</dd>
                </div>
                <div>
                    <dt class="text-xs text-slate-400">Género</dt>
                    <dd class="font-medium">@(cliente.Genero ?? "-")</dd>
                </div>
                <div>
                    <dt class="text-xs text-slate-400">Fecha de nacimiento</dt>
                    <dd class="font-medium">
                        @(cliente.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "-")
                        @if (Edad is not null)
                        {
                            <span class="text-slate-400">(@Edad años)</span>
                        }
                    </dd>
                </div>
            </dl>
        </section>

        <section class="mb-6">
            <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-400">Datos de cliente</h3>
            <dl class="grid gap-x-8 gap-y-3 sm:grid-cols-2">
                <div>
                    <dt class="text-xs text-slate-400">NIT</dt>
                    <dd class="font-medium">@(cliente.Cliente?.Nit ?? "-")</dd>
                </div>
                <div>
                    <dt class="text-xs text-slate-400">Teléfono</dt>
                    <dd class="font-medium">@(cliente.Cliente?.Telefono ?? "-")</dd>
                </div>
                <div>
                    <dt class="text-xs text-slate-400">Dirección</dt>
                    <dd class="font-medium">@(cliente.Cliente?.Direccion ?? "-")</dd>
                </div>
                <div>
                    <dt class="text-xs text-slate-400">Rubro</dt>
                    <dd class="font-medium">@(cliente.Cliente?.Rubro?.NombreRubro ?? "-")</dd>
                </div>
                <div>
                    <dt class="text-xs text-slate-400">Barrio</dt>
                    <dd class="font-medium">@(cliente.Cliente?.Barrio?.NombreBarrio ?? "-")</dd>
                </div>
                <div>
                    <dt class="text-xs text-slate-400">Zona</dt>
                    <dd class="font-medium">@(cliente.Cliente?.Barrio?.Zona?.NombreZona ?? "-")</dd>
                </div>
            </dl>
        </section>

        <section>
            <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-400">Movimientos</h3>
            <div class="rounded border border-dashed border-slate-300 p-6 text-center text-sm text-slate-400">
                Este sistema aún no registra movimientos. El kardex muestra la ficha completa del cliente.
            </div>
        </section>

        <footer class="mt-10 border-t border-slate-200 pt-6 text-center text-xs text-slate-400">
            Documento generado por DSSeptiembre
        </footer>
    </article>
}

@code {
    [Parameter] public long Id { get; set; }

    private Natural? cliente;
    private bool cargando = true;
    private string? mensaje;

    private int? Edad
    {
        get
        {
            if (cliente?.FechaNacimiento is not DateTime nacimiento)
            {
                return null;
            }

            var hoy = DateTime.Today;
            var edad = hoy.Year - nacimiento.Year;
            if (nacimiento.Date > hoy.AddYears(-edad))
            {
                edad--;
            }

            return edad;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        try
        {
            cliente = await ClienteNaturalService.GetByIdAsync(Id);
            if (cliente is null)
            {
                mensaje = $"No existe un cliente natural con el código {Id}.";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"No se pudo cargar el kardex: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }
}
