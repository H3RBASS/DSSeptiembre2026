@page "/clientes-naturales/imprimir"
@inject IClienteNaturalService ClienteNaturalService

<PageTitle>Listado de Clientes Naturales</PageTitle>

<div class="mb-6 flex flex-wrap items-end justify-between gap-3">
    <div>
        <h1 class="text-2xl font-bold">Listado de Clientes Naturales</h1>
        <p class="text-sm text-slate-500">R005 · Imprimir listado de clientes naturales</p>
    </div>
    <div class="print:hidden flex gap-2">
        <a href="clientes-naturales" class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium hover:bg-slate-100">
            Volver
        </a>
        <PrintButton Texto="Imprimir listado" />
    </div>
</div>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="mb-4 rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-700">
        @mensaje
    </div>
}

<section class="rounded-lg bg-white p-8 shadow print:shadow-none">
    <header class="mb-6 flex items-start justify-between gap-4 border-b border-slate-200 pb-4">
        <div>
            <h2 class="text-xl font-bold">DSSeptiembre</h2>
            <p class="text-sm text-slate-500">Listado de clientes naturales</p>
        </div>
        <div class="text-right text-sm text-slate-500">
            <p>Total: <span class="font-medium text-slate-700">@clientes.Count</span></p>
            <p>Emitido: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
    </header>

    @if (cargando)
    {
        <p class="text-sm text-slate-500">Cargando...</p>
    }
    else if (clientes.Count == 0)
    {
        <p class="text-sm text-slate-500">No hay clientes naturales registrados.</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="border-b border-slate-300 text-slate-500">
                        <th class="py-2">#</th>
                        <th class="py-2">Nombre completo</th>
                        <th class="py-2">Documento</th>
                        <th class="py-2">NIT</th>
                        <th class="py-2">Rubro</th>
                        <th class="py-2">Barrio / Zona</th>
                        <th class="py-2">Teléfono</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in clientes)
                    {
                        <tr class="border-b border-slate-100">
                            <td class="py-2">@item.Id</td>
                            <td class="py-2 font-medium">@item.NombreCompleto</td>
                            <td class="py-2">@item.DocumentoIdentidad</td>
                            <td class="py-2">@item.Cliente?.Nit</td>
                            <td class="py-2">@item.Cliente?.Rubro?.NombreRubro</td>
                            <td class="py-2">
                                @item.Cliente?.Barrio?.NombreBarrio
                                @if (item.Cliente?.Barrio?.Zona is not null)
                                {
                                    <span class="text-xs text-slate-400">(@item.Cliente.Barrio.Zona.NombreZona)</span>
                                }
                            </td>
                            <td class="py-2">@item.Cliente?.Telefono</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <footer class="mt-10 border-t border-slate-200 pt-6 text-center text-xs text-slate-400">
        Documento generado por DSSeptiembre
    </footer>
</section>

@code {
    private List<Natural> clientes = new();
    private bool cargando = true;
    private string? mensaje;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            clientes = await ClienteNaturalService.GetAllAsync();
        }
        catch (Exception ex)
        {
            mensaje = $"No se pudo cargar el listado: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }
}
